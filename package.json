{
  "name": "blackwell-backend",
  "version": "1.0.0",
  "description": "Blackwell Time — backend service",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "tsx --conditions=development src/app.ts | pino-pretty",
    "watch": "tsx watch --conditions=development src/app.ts | pino-pretty",
    "build": "tsc -p config/typescript.json",
    "test": "vitest --project unit",
    "test:unit": "vitest --project unit",
    "test:integration": "vitest --project integration",
    "generate": "npx tsx src/utils/swagger/exportSwagger.ts"
  },
  "imports": {
    "#app.js": {
      "types": "./src/app.ts",
      "development": "./src/app.ts",
      "default": "./dist/app.js"
    },
    "#config/*.js": {
      "types": "./src/config/*.ts",
      "development": "./src/config/*.ts",
      "default": "./dist/config/*.js"
    },
    "#db/*.js": {
      "types": "./src/db/*.ts",
      "development": "./src/db/*.ts",
      "default": "./dist/db/*.js"
    },
    "#middleware/*.js": {
      "types": "./src/middleware/*.ts",
      "development": "./src/middleware/*.ts",
      "default": "./dist/middleware/*.js"
    },
    "#models/*.js": {
      "types": "./src/models/*.ts",
      "development": "./src/models/*.ts",
      "default": "./dist/models/*.js"
    },
    "#routes/*.js": {
      "types": "./src/routes/*.ts",
      "development": "./src/routes/*.ts",
      "default": "./dist/routes/*.js"
    },
    "#services/*.js": {
      "types": "./src/services/*.ts",
      "development": "./src/services/*.ts",
      "default": "./dist/services/*.js"
    },
    "#utils/*.js": {
      "types": "./src/utils/*.ts",
      "development": "./src/utils/*.ts",
      "default": "./dist/utils/*.js"
    }
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "googleapis": "^146.0.0",
    "openid-client": "^6.8.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.17.2",
    "pino": "^10.3.0",
    "pino-http": "^11.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/node": "^25.1.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "supertest": "^7.0.0",
    "vitest": "^4.0.18"
  }
}
